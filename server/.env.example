# Copy to .env next to compose.yaml and fill in. .env is never committed.

# gpu (NVIDIA) or cpu.
COMPOSE_PROFILES=gpu

# Shared secret between the app and this server. Type the same value into
# Minutes › Settings › Maximum accuracy. Make one with:  openssl rand -hex 16
MINUTES_TOKEN=

# Your own Hugging Face read token (https://huggingface.co/settings/tokens), from an account
# that accepted the licence at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# large-v3 is the most accurate. large-v3-turbo is ~5x faster with slightly more errors,
# the better choice on a CPU-only PC.
WHISPER_MODEL=large-v3

# The models take ~4-5 GB of GPU memory only while a meeting is processed, then this many
# minutes more (in case you change the speaker count), then the GPU is released for games.
KEEP_LOADED_MINUTES=2

# Leave empty for the defaults: float16 and batch 8 on a GPU, int8 and batch 4 on a CPU.
# On a GPU with less than 8 GB, use COMPUTE_TYPE=int8_float16 and BATCH_SIZE=4.
COMPUTE_TYPE=
BATCH_SIZE=
